# Dinoxo Gamers - Environment Configuration Example
# Copy this file to .env before production deployment. DO NOT commit production secrets.

# Supabase Public API (US East recommended)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key-here

# Commercial Region & Currency
APP_REGION=USA
APP_CURRENCY=USD

# Dinoxo Store Official Information
DINOXO_STORE_WHATSAPP=+584268158785
